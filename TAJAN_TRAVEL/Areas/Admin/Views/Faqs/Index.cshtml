@model List<FAQ>
@{
    ViewData["Title"] = "FAQs";
    var q = ViewData["Q"]?.ToString() ?? "";
}

<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-slate-500">@Model.Count @(Model.Count == 1 ? "question" : "questions")</p>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <form asp-action="Index" method="get" class="relative w-full sm:w-64">
            <i data-lucide="search" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"></i>
            <input name="q" value="@q" type="search" placeholder="Search questions..."
                   class="w-full rounded-lg border border-slate-200 bg-white py-2 pl-9 pr-3 text-sm focus:border-tajan-gold focus:outline-none focus:ring-1 focus:ring-tajan-gold" />
        </form>
        <a asp-action="Create" class="inline-flex items-center justify-center gap-2 rounded-lg bg-tajan-red px-4 py-2 text-sm font-medium text-white hover:bg-[#3a171b]">
            <i data-lucide="plus" class="h-4 w-4"></i> New FAQ
        </a>
    </div>
</div>

<div class="card mt-5 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full min-w-[760px] text-sm">
            <thead>
                <tr class="bg-slate-50/70 text-left text-[11px] font-medium uppercase tracking-wider text-slate-500">
                    <th class="px-6 py-3">#</th>
                    <th class="px-3 py-3">Question</th>
                    <th class="px-3 py-3">Category</th>
                    <th class="px-3 py-3 text-center">Active</th>
                    <th class="px-6 py-3"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model)
                {
                    <tr class="border-t border-slate-100 align-top hover:bg-tajan-cream/60">
                        <td class="px-6 py-3 text-slate-400">@f.DisplayOrder</td>
                        <td class="max-w-xl px-3 py-3">
                            <a asp-action="Edit" asp-route-id="@f.Id" class="font-medium text-[#2A1215] hover:text-tajan-red hover:underline">@f.QuestionEn</a>
                            <div class="mt-0.5 line-clamp-2 text-xs text-slate-500">@f.AnswerEn</div>
                        </td>
                        <td class="px-3 py-3 text-slate-600">@(f.Category ?? "—")</td>
                        <td class="px-3 py-3 text-center"><partial name="_Toggle" model='new ToggleVm("Faqs", f.Id, "active", f.IsActive, q)' /></td>
                        <td class="px-6 py-3"><partial name="_RowActions" model='new RowActionsVm("Faqs", f.Id, "Delete this FAQ?")' /></td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="px-6 py-12 text-center text-slate-400">No FAQs yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
