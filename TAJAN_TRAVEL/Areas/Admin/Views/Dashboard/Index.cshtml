@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard Overview";
}

<div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
    @foreach (var s in Model.Stats)
    {
        var up = s.Change >= 0;
        <div class="card p-5">
            <div class="flex items-start justify-between gap-2">
                <p class="text-sm text-slate-600">@s.Title</p>
                <span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium @(up ? "bg-emerald-50 text-emerald-700" : "bg-red-50 text-red-700")">
                    <i data-lucide="@(up ? "arrow-up-right" : "arrow-down-right")" class="h-3 w-3"></i>@(up ? "+" : "")@(s.Change.ToString("0"))%
                </span>
            </div>
            <div class="mt-3 flex items-baseline gap-2">
                <span class="font-display text-[28px] font-semibold leading-none text-[#2A1215]">@s.Value</span>
                <span class="text-xs text-slate-400">vs last month</span>
            </div>
        </div>
    }
</div>

<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
    @foreach (var c in Model.Content)
    {
        <div class="card p-4">
            <div class="flex items-center justify-between">
                <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-[#F3E9DD] text-tajan-red"><i data-lucide="@c.Icon" class="h-[18px] w-[18px]"></i></span>
                <a asp-area="Admin" asp-controller="@c.Controller" asp-action="@c.AddAction" class="rounded-md p-1.5 text-slate-400 hover:bg-tajan-cream hover:text-tajan-red" title="Add new"><i data-lucide="plus" class="h-4 w-4"></i></a>
            </div>
            <a asp-area="Admin" asp-controller="@c.Controller" asp-action="Index" class="mt-3 block">
                <div class="font-display text-[24px] font-semibold leading-none text-[#2A1215]">@c.Value</div>
                <div class="mt-1 text-sm text-slate-600">@c.Label</div>
                <div class="mt-0.5 text-xs text-slate-400">@c.Sub</div>
            </a>
        </div>
    }
</div>

<div class="mt-6 grid gap-6 lg:grid-cols-3">
    <section class="card overflow-hidden lg:col-span-2">
        <div class="flex items-center justify-between px-6 py-5">
            <h2 class="font-display text-[18px] font-semibold text-[#2A1215]">Recent Bookings</h2>
            <a asp-area="Admin" asp-controller="TourRequests" asp-action="Index" class="text-sm font-medium text-tajan-gold hover:underline">View all</a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full min-w-[560px] text-sm">
                <thead>
                    <tr class="bg-slate-50/70 text-left text-[11px] font-medium uppercase tracking-wider text-slate-500">
                        <th class="px-6 py-3">Booking ID</th>
                        <th class="px-3 py-3">Customer</th>
                        <th class="px-3 py-3">Tour</th>
                        <th class="px-3 py-3">Amount</th>
                        <th class="px-6 py-3">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.RecentBookings)
                    {
                        <tr class="border-t border-slate-100 hover:bg-tajan-cream/60">
                            <td class="px-6 py-4 font-medium text-[#2A1215]">
                                <a asp-area="Admin" asp-controller="TourRequests" asp-action="Details" asp-route-id="@b.InquiryId" class="hover:underline">@b.Code</a>
                            </td>
                            <td class="px-3 py-4 text-slate-600">@b.Customer</td>
                            <td class="px-3 py-4 text-slate-600">@b.Tour</td>
                            <td class="px-3 py-4 font-medium text-[#2A1215]">@b.Amount</td>
                            <td class="px-6 py-4">
                                <span class="rounded-full px-2.5 py-1 text-xs font-medium @AdminFormat.BookingPill(b.Status)">@b.Status</span>
                            </td>
                        </tr>
                    }
                    @if (!Model.RecentBookings.Any())
                    {
                        <tr><td colspan="5" class="px-6 py-10 text-center text-slate-400">No bookings yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="card flex flex-col overflow-hidden">
        <div class="flex items-center justify-between px-6 py-5">
            <h2 class="font-display text-[18px] font-semibold text-[#2A1215]">Pending Requests</h2>
            <span class="rounded-full bg-tajan-red px-2.5 py-1 text-xs font-medium text-white">@Model.PendingNewCount New</span>
        </div>
        <div class="grid grid-cols-2 gap-2 px-6 pb-4">
            <a asp-area="Admin" asp-controller="TourRequests" asp-action="Index" asp-route-type="TourInquiry" asp-route-status="New"
               class="rounded-lg border border-slate-200 px-3 py-2 hover:bg-tajan-cream">
                <span class="block text-lg font-semibold text-tajan-red">@Model.PendingTourCount</span>
                <span class="block text-xs text-slate-500">Tour Details</span>
            </a>
            <a asp-area="Admin" asp-controller="TourRequests" asp-action="Index" asp-route-type="CustomItinerary" asp-route-status="New"
               class="rounded-lg border border-slate-200 px-3 py-2 hover:bg-tajan-cream">
                <span class="block text-lg font-semibold text-tajan-red">@Model.PendingCustomCount</span>
                <span class="block text-xs text-slate-500">Design Your Tour</span>
            </a>
        </div>
        <div class="flex-1">
            @foreach (var r in Model.PendingRequests)
            {
                <div class="border-t border-slate-100 px-6 py-4">
                    <div class="flex items-center justify-between text-xs">
                        <span class="font-medium text-tajan-red">@r.Code</span>
                        <span class="text-slate-400">@r.When</span>
                    </div>
                    <div class="mt-1 text-sm font-medium text-[#2A1215]">@r.Customer</div>
                    <div class="mt-0.5 flex items-center justify-between gap-2">
                        <span class="truncate text-sm text-slate-500">@r.Place</span>
                        <span class="shrink-0 rounded bg-[#F3E9DD] px-2 py-0.5 text-[11px] text-[#6B4A3A]">@r.Tag</span>
                    </div>
                    <div class="mt-3 grid grid-cols-2 gap-2">
                        <a asp-area="Admin" asp-controller="TourRequests" asp-action="Details" asp-route-id="@r.InquiryId"
                           class="rounded-md border border-slate-200 py-2 text-center text-sm text-slate-700 hover:bg-tajan-cream">Review</a>
                        <a href="@r.ReplyUrl" target="_blank" rel="noopener"
                           class="rounded-md bg-tajan-red py-2 text-center text-sm font-medium text-white hover:bg-[#3a171b]">Reply</a>
                    </div>
                </div>
            }
            @if (!Model.PendingRequests.Any())
            {
                <div class="border-t border-slate-100 px-6 py-10 text-center text-sm text-slate-400">No pending requests.</div>
            }
        </div>
        <a asp-area="Admin" asp-controller="TourRequests" asp-action="Index" asp-route-status="New"
           class="border-t border-slate-100 py-3.5 text-center text-sm text-slate-500 hover:bg-tajan-cream">View all requests</a>
    </section>
</div>

<div class="mt-6 grid gap-6 lg:grid-cols-3">
    <section class="card p-6 lg:col-span-2">
        <h2 class="font-display text-[18px] font-semibold text-[#2A1215]">Last 6 months</h2>
        <p class="mt-1 text-xs text-slate-400">Requests received per month · estimated revenue of confirmed / completed files</p>
        @{
            var maxReq = Math.Max(1, Model.Trend.Max(t => t.Requests));
        }
        <div class="mt-6 flex h-44 items-end gap-3">
            @foreach (var t in Model.Trend)
            {
                var h = (int)Math.Round(t.Requests * 100.0 / maxReq);
                <div class="flex h-full flex-1 flex-col items-center justify-end gap-2">
                    <span class="text-xs font-medium text-[#2A1215]">@t.Requests</span>
                    <div class="w-full rounded-t-md bg-tajan-red/80" style="height:@(Math.Max(h, t.Requests > 0 ? 4 : 1))%" title="@t.Requests requests"></div>
                </div>
            }
        </div>
        <div class="mt-2 flex gap-3">
            @foreach (var t in Model.Trend)
            {
                <div class="flex-1 text-center">
                    <div class="text-xs text-slate-500">@t.Label</div>
                    <div class="text-[11px] text-slate-400">@(t.Revenue > 0 ? AdminFormat.Money(t.Revenue) : "—")</div>
                </div>
            }
        </div>
    </section>

    <div class="space-y-6">
        <section class="card p-6">
            <h2 class="font-display text-[18px] font-semibold text-[#2A1215]">Pipeline</h2>
            @{
                var totalReq = Math.Max(1, Model.StatusBreakdown.Sum(s => s.Count));
            }
            <div class="mt-4 space-y-3">
                @foreach (var s in Model.StatusBreakdown)
                {
                    <div>
                        <div class="flex justify-between text-xs text-slate-600"><span>@s.Label</span><span class="font-medium text-[#2A1215]">@s.Count</span></div>
                        <div class="mt-1 h-2 overflow-hidden rounded-full bg-slate-100">
                            <div class="h-2 rounded-full @s.Bar" style="width:@((int)Math.Round(s.Count * 100.0 / totalReq))%"></div>
                        </div>
                    </div>
                }
            </div>
        </section>

        <section class="card p-6">
            <h2 class="font-display text-[18px] font-semibold text-[#2A1215]">Most requested tours</h2>
            <div class="mt-4 space-y-2">
                @foreach (var t in Model.TopTours)
                {
                    <a asp-area="Admin" asp-controller="Tours" asp-action="Edit" asp-route-id="@t.Id" class="flex items-center justify-between gap-3 rounded-lg px-2 py-1.5 text-sm hover:bg-tajan-cream">
                        <span class="truncate text-slate-700">@t.Title</span>
                        <span class="shrink-0 rounded-full bg-[#F1E6D6] px-2 py-0.5 text-xs font-medium text-tajan-red">@t.Requests</span>
                    </a>
                }
                @if (!Model.TopTours.Any())
                {
                    <div class="py-4 text-center text-sm text-slate-400">No requests linked to tours yet.</div>
                }
            </div>
        </section>
    </div>
</div>

<div class="mt-6 grid gap-6 lg:grid-cols-2">
    <section class="card p-6">
        <h2 class="font-display text-[18px] font-semibold text-[#2A1215]">Upcoming Departures (Next 7 Days)</h2>
        <div class="mt-5 space-y-3">
            @foreach (var d in Model.Departures)
            {
                <a asp-area="Admin" asp-controller="TourRequests" asp-action="Details" asp-route-id="@d.InquiryId"
                   class="flex items-center justify-between gap-3 rounded-lg bg-slate-50 px-4 py-3 hover:bg-tajan-cream">
                    <div class="min-w-0">
                        <div class="truncate text-sm font-medium text-[#2A1215]">@d.Title</div>
                        <div class="mt-0.5 truncate text-xs text-slate-500">@d.Sub</div>
                    </div>
                    <div class="shrink-0 text-right">
                        <div class="text-sm font-semibold text-[#2A1215]">@d.Date</div>
                        <div class="mt-0.5 text-xs text-slate-500">@d.Guests</div>
                    </div>
                </a>
            }
            @if (!Model.Departures.Any())
            {
                <div class="rounded-lg bg-slate-50 px-4 py-8 text-center text-sm text-slate-400">No departures in the next 7 days.</div>
            }
        </div>
    </section>

    <section class="flex flex-col justify-between rounded-xl bg-tajan-red p-8 shadow-[0_1px_3px_rgba(75,30,35,.12)]">
        <div>
            <h2 class="font-display text-[22px] font-semibold text-tajan-gold">Crafting the Extraordinary</h2>
            <p class="mt-3 max-w-md text-sm leading-relaxed text-white/70">
                You have @Model.ProposalsPending customized tour @(Model.ProposalsPending == 1 ? "proposal" : "proposals") pending review.
                Personalizing these experiences on time increases conversion by 40%.
            </p>
        </div>
        <div class="mt-10">
            <a asp-area="Admin" asp-controller="TourRequests" asp-action="Index" asp-route-status="New" asp-route-type="CustomItinerary"
               class="inline-flex items-center gap-2 rounded-md bg-tajan-gold px-5 py-2.5 text-sm font-medium text-tajan-red hover:brightness-105">
                Review Proposals <i data-lucide="arrow-up-right" class="h-4 w-4"></i>
            </a>
        </div>
    </section>
</div>
