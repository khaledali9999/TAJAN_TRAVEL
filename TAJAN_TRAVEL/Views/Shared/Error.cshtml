@{
    ViewData["Title"] = T["Error"];
}
<div class="max-w-2xl mx-auto px-6 py-24 text-center">
    <h1 class="font-display text-3xl text-tajan-red mb-4">@T["Something went wrong"]</h1>
    <p class="text-tajan-red/70">@T["Please try again, or reach us directly on WhatsApp"] / hello@tajantravel.com.</p>
    <a asp-controller="Home" asp-action="Index" class="inline-block mt-8 bg-tajan-red text-white px-6 py-3 text-xs uppercase tracking-widest">
        @T["Back to Home"]
    </a>
</div>
