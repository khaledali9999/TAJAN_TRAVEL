@*
    Wishlist popup (modal).
    Client-side only: items are kept in localStorage (no wishlist table in the DB yet),
    so it works across the whole site without extra backend endpoints.
    Opened from _Navbar.cshtml via TajanWishlist.open(), and from any "heart" button
    that carries data-wishlist-heart + data-* attributes (see _TourCard.cshtml).
*@

<div id="wishlist-modal"
     class="hidden fixed inset-0 z-[100] items-center justify-center p-4"
     aria-hidden="true"
     role="dialog"
     aria-modal="true"
     aria-labelledby="wishlist-modal-title">

    <!-- Backdrop -->
    <div id="wishlist-modal-backdrop" class="absolute inset-0 bg-tajan-red/40 backdrop-blur-sm"></div>

    <!-- Panel -->
    <div class="relative w-full max-w-md bg-white rounded-2xl shadow-2xl overflow-hidden">
        <div class="wishlist-scroll max-h-[90vh] overflow-y-auto p-6 sm:p-8">

            <div class="flex items-start justify-between">
                <span class="text-tajan-gold text-xs font-semibold uppercase tracking-[0.2em]">@T["My Wishlist"]</span>
                <button type="button"
                        id="wishlist-modal-close"
                        aria-label="@T["Close"]"
                        class="w-8 h-8 rounded-full bg-tajan-cream flex items-center justify-center text-tajan-red hover:bg-tajan-sand/50 transition shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <h2 id="wishlist-modal-title" class="font-display text-2xl sm:text-3xl text-tajan-red leading-snug mt-3">
                @T["Your saved journeys and places in Egypt"]
            </h2>

            <hr class="border-tajan-gold/20 mt-5" />

            <div class="flex items-center justify-between mt-5">
                <span class="font-display text-lg text-tajan-red">@T["Your Selection"]</span>
                <span id="wishlist-count-pill"
                      class="inline-flex items-center gap-1.5 border border-tajan-gold text-tajan-red text-xs font-medium rounded-full px-3 py-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-tajan-gold" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 21s-6.716-4.35-9.428-8.03C.6 10.24 1.1 6.6 4.05 5.06 6.43 3.82 9.1 4.6 12 7.64c2.9-3.04 5.57-3.82 7.95-2.58 2.95 1.54 3.45 5.18 1.48 7.91C18.716 16.65 12 21 12 21z" />
                    </svg>
                    <span id="wishlist-count-text">@T["0 Items"]</span>
                </span>
            </div>

            <!-- Items -->
            <div id="wishlist-items" class="space-y-3 mt-5"></div>

            <!-- Empty state -->
            <div id="wishlist-empty" class="hidden flex-col items-center text-center py-10">
                <div class="w-14 h-14 rounded-full bg-tajan-cream flex items-center justify-center mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-tajan-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 016.364 0L12 7.636l1.318-1.318a4.5 4.5 0 116.364 6.364L12 21l-7.682-7.682a4.5 4.5 0 010-6.364z" />
                    </svg>
                </div>
                <p class="text-tajan-red/70 text-sm max-w-[26ch]">
                    @T["Your wishlist is empty. Tap the heart on any tour or destination to save it here."]
                </p>
                <a asp-controller="Tours" asp-action="Index"
                   class="inline-flex items-center gap-2 mt-5 border border-tajan-gold text-tajan-red px-5 py-2.5 text-xs uppercase tracking-widest hover:bg-tajan-gold hover:text-white transition">
                    @T["Browse Tours"]
                </a>
            </div>

            <hr class="border-tajan-gold/20 mt-6" />

            <p class="text-center text-tajan-red/70 text-sm mt-5">
                @T["Ready to turn your saved ideas into your Egypt journey?"]
            </p>

            <a asp-controller="Inquiry" asp-action="Create"
               class="mt-4 flex items-center justify-center gap-2 bg-tajan-red text-white rounded-full py-3.5 text-xs sm:text-sm uppercase tracking-widest hover:bg-tajan-red/90 transition">
                @T["Plan Your Journey"]
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
            </a>
        </div>
    </div>
</div>

<style>
    .wishlist-scroll {
        scrollbar-width: thin;
        scrollbar-color: rgba(200, 164, 77, 0.55) transparent;
    }

        .wishlist-scroll::-webkit-scrollbar {
            width: 6px;
        }

        .wishlist-scroll::-webkit-scrollbar-track {
            background: transparent;
            margin: 16px 0;
        }

        .wishlist-scroll::-webkit-scrollbar-thumb {
            background: rgba(200, 164, 77, 0.55);
            border-radius: 9999px;
        }

            .wishlist-scroll::-webkit-scrollbar-thumb:hover {
                background: rgba(200, 164, 77, 0.85);
            }
</style>

<!-- Item card template (cloned by JS) -->
<template id="wishlist-item-template">
    <div class="wishlist-item relative flex gap-3 bg-tajan-cream/60 border border-tajan-gold/10 rounded-xl p-3">
        <img class="wi-image w-20 h-20 rounded-lg object-cover shrink-0 bg-tajan-sand/40" src="" alt="" />
        <div class="min-w-0 flex-1">
            <span class="wi-badge inline-block bg-tajan-sand/50 text-tajan-red text-[10px] uppercase tracking-widest px-2 py-1 rounded"></span>
            <h3 class="wi-title font-display text-base sm:text-lg text-tajan-red mt-1 truncate"></h3>
            <p class="wi-meta text-xs text-tajan-red/60 mt-0.5"></p>
            <div class="flex items-end justify-between mt-2">
                <p class="wi-price text-sm text-tajan-red"></p>
                <a class="wi-link inline-flex items-center gap-1 text-[11px] font-semibold uppercase tracking-wide text-tajan-red hover:text-tajan-gold transition" href="#">
                    <span class="wi-link-label"></span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                </a>
            </div>
        </div>
        <button type="button" class="wi-remove absolute top-2.5 right-2.5 w-7 h-7 rounded-full bg-white shadow flex items-center justify-center text-tajan-red hover:text-tajan-gold transition" aria-label="@T["Remove from wishlist"]">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 21s-6.716-4.35-9.428-8.03C.6 10.24 1.1 6.6 4.05 5.06 6.43 3.82 9.1 4.6 12 7.64c2.9-3.04 5.57-3.82 7.95-2.58 2.95 1.54 3.45 5.18 1.48 7.91C18.716 16.65 12 21 12 21z" />
            </svg>
        </button>
    </div>
</template>

<style>
    #wishlist-modal.flex {
        display: flex;
    }

    #wishlist-empty.flex {
        display: flex;
    }

    .wishlist-heart-btn svg {
        transition: fill .15s ease, color .15s ease;
    }

    .wishlist-heart-btn.is-active svg {
        fill: currentColor;
    }
</style>

<script>
    (function () {
        // Mirrors Models/Entities/WishlistItem.WishlistItemType (Tour = 0, Destination = 1).
        var TYPE = { Tour: 0, Destination: 1 };

        // Local cache of the last server response, just so the modal / hearts
        // can repaint instantly without waiting on a round trip every time.
        var lastResult = { count: 0, items: [] };
        var savedKeys = {};

        function api(url, options) {
            options = options || {};
            options.headers = Object.assign({ 'Content-Type': 'application/json' }, options.headers || {});
            options.credentials = 'same-origin';
            return fetch(url, options).then(function (res) {
                if (!res.ok) throw new Error('Wishlist request failed: ' + res.status);
                return res.json();
            });
        }

        function applyResult(result) {
            lastResult = result || { count: 0, items: [] };
            savedKeys = {};
            lastResult.items.forEach(function (item) { savedKeys[item.key] = item.id; });
            renderModal();
            updateHeaderBadges();
            syncHeartButtons();
        }

        function refresh() {
            return api('/Wishlist').then(applyResult).catch(function () { /* ignore - keep last known state */ });
        }

        function toggleItem(type, refId, btn) {
            if (btn) btn.disabled = true;
            return api('/Wishlist/Toggle', {
                method: 'POST',
                body: JSON.stringify({ type: type, refId: refId })
            })
                .then(applyResult)
                .catch(function () { /* keep hearts as they were on failure */ })
                .finally(function () { if (btn) btn.disabled = false; });
        }

        function removeItem(id) {
            return api('/Wishlist/Remove/' + id, { method: 'POST' })
                .then(applyResult)
                .catch(function () { /* ignore */ });
        }

        function updateHeaderBadges() {
            var count = lastResult.count;
            document.querySelectorAll('[data-wishlist-count]').forEach(function (el) {
                el.textContent = count;
                el.classList.toggle('hidden', count === 0);
            });
            var pillText = document.getElementById('wishlist-count-text');
            if (pillText) pillText.textContent = count + (count === 1 ? ' Item' : ' Items');
        }

        function syncHeartButtons() {
            document.querySelectorAll('[data-wishlist-heart]').forEach(function (btn) {
                var key = (btn.getAttribute('data-type') === String(TYPE.Tour) ? 'tour-' : 'dest-') + btn.getAttribute('data-ref-id');
                var active = Object.prototype.hasOwnProperty.call(savedKeys, key);
                btn.classList.toggle('is-active', active);
                btn.setAttribute('aria-pressed', active ? 'true' : 'false');
            });
        }

        function renderModal() {
            var items = lastResult.items;
            var list = document.getElementById('wishlist-items');
            var empty = document.getElementById('wishlist-empty');
            var tpl = document.getElementById('wishlist-item-template');
            if (!list || !empty || !tpl) return;

            list.innerHTML = '';

            if (items.length === 0) {
                list.classList.add('hidden');
                empty.classList.remove('hidden');
                empty.classList.add('flex');
                return;
            }

            list.classList.remove('hidden');
            empty.classList.add('hidden');
            empty.classList.remove('flex');

            items.forEach(function (item) {
                var node = tpl.content.firstElementChild.cloneNode(true);
                var img = node.querySelector('.wi-image');
                img.src = item.image || '';
                img.alt = item.title || '';
                node.querySelector('.wi-badge').textContent = item.badge || '';
                node.querySelector('.wi-title').textContent = item.title || '';
                node.querySelector('.wi-meta').textContent = item.meta || '';
                node.querySelector('.wi-price').textContent = item.price || '';
                var link = node.querySelector('.wi-link');
                link.href = item.url || '#';
                node.querySelector('.wi-link-label').textContent = item.linkLabel || 'View';
                node.querySelector('.wi-remove').addEventListener('click', function () {
                    removeItem(item.id);
                });
                list.appendChild(node);
            });
        }

        function openModal() {
            var modal = document.getElementById('wishlist-modal');
            if (!modal) return;
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            modal.setAttribute('aria-hidden', 'false');
            document.body.classList.add('overflow-hidden');
            renderModal();
            refresh();
        }

        function closeModal() {
            var modal = document.getElementById('wishlist-modal');
            if (!modal) return;
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            modal.setAttribute('aria-hidden', 'true');
            document.body.classList.remove('overflow-hidden');
        }

        // Public API (kept for any inline onclick="" hooks elsewhere)
        window.TajanWishlist = {
            open: openModal,
            close: closeModal,
            remove: removeItem,
            refresh: refresh,
            TYPE: TYPE
        };

        document.addEventListener('DOMContentLoaded', function () {
            var closeBtn = document.getElementById('wishlist-modal-close');
            var backdrop = document.getElementById('wishlist-modal-backdrop');
            if (closeBtn) closeBtn.addEventListener('click', closeModal);
            if (backdrop) backdrop.addEventListener('click', closeModal);

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeModal();
            });

            // Delegate heart-button clicks anywhere on the site.
            document.addEventListener('click', function (e) {
                var btn = e.target.closest('[data-wishlist-heart]');
                if (!btn) return;
                e.preventDefault();
                e.stopPropagation();
                var type = parseInt(btn.getAttribute('data-type'), 10);
                var refId = parseInt(btn.getAttribute('data-ref-id'), 10);
                if (!refId) return;
                toggleItem(type, refId, btn);
            });

            // Load this visitor's saved items once so hearts are correct on every page.
            refresh();
        });
    })();
</script>
