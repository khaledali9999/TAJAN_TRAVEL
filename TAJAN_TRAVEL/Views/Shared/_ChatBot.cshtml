<div id="chatbot-panel" class="hidden fixed bottom-24 right-6 z-50 w-80 max-w-[90vw] bg-white border border-tajan-gold/30 shadow-xl rounded-lg overflow-hidden">
    <div class="bg-tajan-red text-white px-4 py-3 flex items-center justify-between">
        <span class="text-sm tracking-wide">@T["✦ Plan with AI"]</span>
        <button type="button" class="text-white/80 hover:text-white" onclick="document.getElementById('chatbot-panel').classList.add('hidden')">&times;</button>
    </div>
    <div class="p-4 text-sm text-tajan-red/80 space-y-3">
        <p>@T["Tell me what kind of trip you're dreaming of, and I'll suggest a Tajan experience for you."]</p>
        <p class="text-xs text-tajan-red/50">
            @T["(Live AI responses will be connected to the Gemini-powered AIChatService in the Integrations phase.)"]
        </p>
    </div>
</div>
