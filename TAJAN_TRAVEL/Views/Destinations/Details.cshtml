@model TAJAN_TRAVEL.Models.Entities.Destination
@{
    ViewData["Title"] = Lang.Pick(Model.NameEn, Model.NameFr);
}

<!-- ??????????????? HERO ??????????????? -->
<section class="relative h-[55vh] min-h-[380px] flex items-end overflow-hidden">
    <div class="absolute inset-0">
        @{
            var heroImg = !string.IsNullOrEmpty(Model.HeroImageUrl) ? Model.HeroImageUrl : Model.CoverImageUrl;
        }
        @if (!string.IsNullOrEmpty(heroImg))
        {
            <img src="@heroImg"
                 alt="@Lang.Pick(Model.NameEn, Model.NameFr)"
                 class="w-full h-full object-cover" />
        }
        else
        {
            <div class="w-full h-full bg-tajan-sand/60"></div>
        }
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
    </div>

    <div class="relative max-w-5xl mx-auto px-6 pb-14 text-white w-full">
        <!-- breadcrumb -->
        <nav class="flex items-center gap-2 text-[10px] uppercase tracking-widest text-white/50 mb-5">
            <a asp-controller="Home" asp-action="Index" class="hover:text-tajan-gold transition">@T["Home"]</a>
            <span>/</span>
            <a asp-controller="Destinations" asp-action="Index" class="hover:text-tajan-gold transition">@T["Destinations"]</a>
            <span>/</span>
            <span class="text-tajan-gold">@Lang.Pick(Model.NameEn, Model.NameFr)</span>
        </nav>

        <div class="text-[10px] uppercase tracking-[0.3em] text-tajan-gold mb-3">@Lang.T(Lang.Pick(Model.Category, Model.CategoryFr))</div>
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl leading-tight">@Lang.Pick(Model.NameEn, Model.NameFr)</h1>

        <!-- meta badges -->
        @if (!string.IsNullOrEmpty(Model.BestTime) || !string.IsNullOrEmpty(Model.KnownFor))
        {
            <div class="flex flex-wrap items-center gap-6 mt-6">
                @if (!string.IsNullOrEmpty(Model.BestTime))
                {
                    <div class="flex items-center gap-2 text-white/80 text-xs">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                             stroke-linejoin="round" class="w-4 h-4 text-tajan-gold shrink-0">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                            <line x1="16" y1="2" x2="16" y2="6" />
                            <line x1="8" y1="2" x2="8" y2="6" />
                            <line x1="3" y1="10" x2="21" y2="10" />
                        </svg>
                        <span>@T["Best Time:"] <span class="text-white font-medium">@Lang.Pick(Model.BestTime, Model.BestTimeFr)</span></span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.KnownFor))
                {
                    <div class="flex items-center gap-2 text-white/80 text-xs">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                             stroke-linejoin="round" class="w-4 h-4 text-tajan-gold shrink-0">
                            <line x1="3" y1="22" x2="3" y2="10" />
                            <line x1="21" y1="22" x2="21" y2="10" />
                            <polyline points="3 10 12 3 21 10" />
                            <line x1="12" y1="22" x2="12" y2="3" />
                        </svg>
                        <span>@T["Known For:"] <span class="text-white font-medium">@Lang.Pick(Model.KnownFor, Model.KnownForFr)</span></span>
                    </div>
                }
            </div>
        }
    </div>
</section>

<!-- ??????????????? DESCRIPTION ??????????????? -->
<section class="max-w-3xl mx-auto px-6 py-16 sm:py-20">
    <div class="flex items-center gap-4 text-[10px] uppercase tracking-[0.3em] text-tajan-gold mb-8">
        <span class="w-10 h-px bg-tajan-gold/50"></span>
        <span>@T["Destination Guide"]</span>
        <span class="w-10 h-px bg-tajan-gold/50"></span>
    </div>

    @if (!string.IsNullOrEmpty(Lang.Pick(Model.LongDescriptionEn, Model.LongDescriptionFr)))
    {
        <p class="text-tajan-red/80 text-base sm:text-lg leading-relaxed mb-6">
            @Lang.Pick(Model.LongDescriptionEn, Model.LongDescriptionFr)
        </p>
    }
    else
    {
        <p class="text-tajan-red/80 text-base sm:text-lg leading-relaxed mb-6">
            @Lang.Pick(Model.DescriptionEn, Model.DescriptionFr)
        </p>
    }

    <a asp-controller="Contact" asp-action="Index"
       class="inline-flex items-center gap-3 bg-tajan-red text-white
              text-xs uppercase tracking-widest px-8 py-4
              hover:bg-tajan-red/90 transition mt-4">
        @T["Contact Us For More Info"]
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round"
             stroke-linejoin="round" class="w-4 h-4">
            <path d="M5 12h14" />
            <path d="M13 6l6 6-6 6" />
        </svg>
    </a>
</section>

<!-- ??????????????? RELATED TOURS ??????????????? -->
@if (Model.Tours != null && Model.Tours.Any())
{
    <section class="bg-tajan-sand/20 border-t border-tajan-gold/20 py-16 sm:py-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6">
            <div class="text-center mb-12">
                <div class="text-xs uppercase tracking-[0.3em] text-tajan-gold mb-3">
                    @T["Curated For You"]
                </div>
                <h2 class="font-display text-3xl sm:text-4xl text-tajan-red">
                    @T["Tours in {0}", Lang.Pick(Model.NameEn, Model.NameFr)]
                </h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                @foreach (var tour in Model.Tours)
                {
                    @await Html.PartialAsync("_TourCard", tour)
                }
            </div>
        </div>
    </section>
}

<!-- ??????????????? BACK LINK ??????????????? -->
<section class="py-10 text-center border-t border-tajan-gold/20">
    <a asp-controller="Destinations" asp-action="Index"
       class="inline-flex items-center gap-2 text-xs uppercase tracking-widest
              text-tajan-gold hover:gap-3 transition-all duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round"
             stroke-linejoin="round" class="w-3.5 h-3.5 rotate-180">
            <path d="M5 12h14" />
            <path d="M13 6l6 6-6 6" />
        </svg>
        @T["All Destinations"]
    </a>
</section>
