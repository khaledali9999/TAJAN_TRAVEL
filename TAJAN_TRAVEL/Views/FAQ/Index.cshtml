@model List<TAJAN_TRAVEL.Models.Entities.FAQ>
@{
    ViewData["Title"] = T["FAQ"];
    ViewData["Description"] = T["Everything you need to know about planning your bespoke Egyptian journey."];

    // Categories come from the admin (free text), so the filter tabs are built from the real data
    var grouped = Model
        .GroupBy(f => string.IsNullOrWhiteSpace(f.Category) ? "General" : f.Category.Trim())
        .ToDictionary(g => g.Key, g => g.ToList());
    var categories = grouped.Keys.ToList();

    // Display label per category (French name if the admin filled it in, otherwise English)
    var catLabels = Model
        .Where(f => !string.IsNullOrWhiteSpace(f.Category))
        .GroupBy(f => f.Category!.Trim())
        .ToDictionary(g => g.Key, g => Lang.Pick(g.Key, g.Select(x => x.CategoryFr).FirstOrDefault(x => !string.IsNullOrWhiteSpace(x))));
    string CatLabel(string key) => Lang.T(catLabels.TryGetValue(key, out var lbl) ? lbl : key);
}

@section Styles {
    <style>
        .faq-hero {
            background: linear-gradient(135deg, #FAF6F0 0%, #F0E8D8 100%);
            border-bottom: 1px solid rgba(200,164,77,0.15);
        }

        .filter-tab {
            border: 1.5px solid #C8A44D;
            color: #4B1E23;
            background: transparent;
            padding: 8px 20px;
            font-size: 0.78rem;
            letter-spacing: 0.05em;
            cursor: pointer;
            transition: all 0.2s ease;
            border-radius: 999px;
            white-space: nowrap;
            font-family: 'Jost', sans-serif;
        }

            .filter-tab:hover,
            .filter-tab.active {
                background: #4B1E23;
                color: #FAF6F0;
                border-color: #4B1E23;
            }

        .faq-item {
            background: #fff;
            border: 1px solid rgba(200,164,77,0.2);
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

            .faq-item:hover {
                border-color: rgba(200,164,77,0.5);
                box-shadow: 0 2px 12px rgba(75,30,35,0.06);
            }

        .faq-btn {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            padding: 20px 24px;
            text-align: left;
            background: none;
            border: none;
            cursor: pointer;
            gap: 16px;
        }

        .faq-icon {
            width: 28px;
            height: 28px;
            min-width: 28px;
            border-radius: 50%;
            border: 1.5px solid #C8A44D;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #C8A44D;
            transition: all 0.25s ease;
            font-size: 1.1rem;
            line-height: 1;
        }

        .faq-item.open .faq-icon {
            background: #C8A44D;
            color: #fff;
            transform: rotate(45deg);
        }

        .faq-answer {
            display: none;
            padding: 0 24px 20px;
            color: rgba(75,30,35,0.72);
            font-size: 0.9rem;
            line-height: 1.75;
            border-top: 1px solid rgba(200,164,77,0.12);
            padding-top: 16px;
        }

        .faq-item.open .faq-answer {
            display: block;
        }

        .category-section {
            transition: opacity 0.2s ease;
        }

            .category-section.hidden-section {
                display: none;
            }

        .search-input {
            background: #fff;
            border: 1.5px solid rgba(200,164,77,0.3);
            border-radius: 6px;
            padding: 13px 20px 13px 46px;
            font-family: 'Jost', sans-serif;
            font-size: 0.9rem;
            color: #4B1E23;
            outline: none;
            width: 100%;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

            .search-input:focus {
                border-color: #C8A44D;
                box-shadow: 0 0 0 3px rgba(200,164,77,0.12);
            }

            .search-input::placeholder {
                color: rgba(75,30,35,0.4);
            }

        .no-results {
            display: none;
            text-align: center;
            padding: 48px 0;
            color: rgba(75,30,35,0.45);
            font-size: 0.9rem;
        }

        .contact-box {
            background: #fff;
            border: 1px solid rgba(200,164,77,0.2);
            border-radius: 8px;
        }

        .contact-email-input {
            border: 1.5px solid rgba(200,164,77,0.3);
            background: #FAF6F0;
            padding: 11px 16px 11px 40px;
            font-family: 'Jost', sans-serif;
            font-size: 0.85rem;
            color: #4B1E23;
            outline: none;
            border-radius: 4px;
            flex: 1;
            min-width: 0;
            transition: border-color 0.2s;
        }

            .contact-email-input:focus {
                border-color: #C8A44D;
            }

            .contact-email-input::placeholder {
                color: rgba(75,30,35,0.4);
            }

        .btn-contact {
            background: #4B1E23;
            color: #FAF6F0;
            padding: 11px 24px;
            font-size: 0.8rem;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            border: none;
            cursor: pointer;
            border-radius: 4px;
            font-family: 'Jost', sans-serif;
            transition: background 0.2s ease;
            white-space: nowrap;
        }

            .btn-contact:hover {
                background: #3a1519;
            }

        .wa-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            background: #25D366;
            border-radius: 50%;
            flex-shrink: 0;
            transition: transform 0.2s ease;
        }

            .wa-btn:hover {
                transform: scale(1.08);
            }

        .category-label {
            font-family: 'Playfair Display', serif;
            font-size: 1.3rem;
            color: #4B1E23;
            padding-bottom: 12px;
            border-bottom: 1.5px solid rgba(200,164,77,0.3);
            margin-bottom: 16px;
        }

        .faq-empty {
            text-align: center;
            padding: 80px 0;
            color: rgba(75,30,35,0.5);
        }
    </style>
}

<!-- Hero -->
<div class="faq-hero pt-32 pb-14 px-6 text-center">
    <div class="max-w-2xl mx-auto">
        <p class="text-xs uppercase tracking-[0.3em] text-tajan-gold mb-3">@T["— Help Center & Guide —"]</p>
        <h1 class="font-display text-4xl md:text-5xl text-tajan-red mb-4">@T["Frequently Asked Questions"]</h1>
        <p class="text-tajan-red/60 text-sm mb-10">@T["Everything you need to know about planning your bespoke Egyptian journey."]</p>

        <!-- Search -->
        <div class="relative max-w-xl mx-auto">
            <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-tajan-red/40 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 115 11a6 6 0 0112 0z" />
            </svg>
            <input id="faq-search"
                   type="text"
                   class="search-input"
                   placeholder="@T["Search questions, visa requirements, booking policies..."]" />
        </div>
    </div>
</div>

<!-- Filter Tabs -->
<div class="sticky top-[64px] z-30 bg-tajan-cream/95 backdrop-blur-sm border-b border-tajan-gold/10 py-4 px-6">
    <div class="max-w-4xl mx-auto">
        <div class="flex gap-2 overflow-x-auto pb-1 scrollbar-hide" id="filter-tabs">
            <button type="button" class="filter-tab active" data-cat="all">@T["All Questions"]</button>
            @foreach (var cat in categories)
            {
                <button type="button" class="filter-tab" data-cat="@cat">@CatLabel(cat)</button>
            }
        </div>
    </div>
</div>

<!-- FAQ Content -->
<section class="max-w-4xl mx-auto px-6 py-14">

    @if (!Model.Any())
    {
        <div class="faq-empty">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 mx-auto mb-4 text-tajan-gold/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <p class="text-tajan-red/50">@T["FAQs will appear here once added from the admin dashboard."]</p>
        </div>
    }
    else
    {
        <!-- No results message -->
        <div class="no-results" id="no-results">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 mx-auto mb-3 text-tajan-gold/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            @T["No questions found matching your search."]
        </div>

        <!-- Grouped FAQs -->
        <div id="faq-container" class="space-y-12">
            @foreach (var group in grouped)
            {
                <div class="category-section" data-category="@group.Key">
                    <h2 class="category-label">@CatLabel(group.Key)</h2>
                    <div class="space-y-3">
                        @foreach (var faq in group.Value)
                        {
                            <div class="faq-item" data-question="@Lang.Pick(faq.QuestionEn, faq.QuestionFr).ToLower()" data-answer="@Lang.Pick(faq.AnswerEn, faq.AnswerFr).ToLower()">
                                <button class="faq-btn" onclick="toggleFaq(this)">
                                    <span class="font-display text-[1.05rem] text-tajan-red leading-snug">@Lang.Pick(faq.QuestionEn, faq.QuestionFr)</span>
                                    <span class="faq-icon">+</span>
                                </button>
                                <div class="faq-answer">
                                    @Lang.Pick(faq.AnswerEn, faq.AnswerFr)
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</section>

<!-- Contact Box -->
<section class="max-w-4xl mx-auto px-6 pb-20">
    <div class="contact-box p-8 md:p-10">
        <div class="flex flex-col md:flex-row gap-8 items-start md:items-center">
            <div class="flex-1">
                <h3 class="font-display text-xl text-tajan-red mb-2">@T["Still have unanswered questions?"]</h3>
                <p class="text-sm text-tajan-red/60 leading-relaxed">
                    @T["Leave your email and our private travel specialists will reach out to you within 24 hours, or contact us directly on WhatsApp."]
                </p>
            </div>
            <div class="flex items-center gap-3 w-full md:w-auto">
                <div class="relative flex-1 md:w-64">
                    <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-tajan-red/35 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    <input type="email" class="contact-email-input w-full" placeholder="@T["Enter your email address..."]" id="faq-contact-email" />
                </div>
                <button class="btn-contact" onclick="submitFaqContact()">@T["Contact Me"]</button>
                <a href="https://wa.me/201234567890" target="_blank" class="wa-btn" title="@T["Chat on WhatsApp"]">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="white">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                    </svg>
                </a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Toggle FAQ
        function toggleFaq(btn) {
            const item = btn.closest('.faq-item');
            const isOpen = item.classList.contains('open');
            // Close all
            document.querySelectorAll('.faq-item.open').forEach(el => el.classList.remove('open'));
            // Open clicked if it was closed
            if (!isOpen) item.classList.add('open');
        }

        // Filter tabs
        document.querySelectorAll('.filter-tab').forEach(tab => {
            tab.addEventListener('click', function () {
                document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
                this.classList.add('active');

                const cat = this.dataset.cat;
                document.querySelectorAll('.category-section').forEach(section => {
                    if (cat === 'all' || section.dataset.category === cat) {
                        section.classList.remove('hidden-section');
                    } else {
                        section.classList.add('hidden-section');
                    }
                });

                // Reset search
                document.getElementById('faq-search').value = '';
                document.querySelectorAll('.faq-item').forEach(i => i.style.display = '');
                document.getElementById('no-results').style.display = 'none';
            });
        });

        // Search
        document.getElementById('faq-search').addEventListener('input', function () {
            const q = this.value.toLowerCase().trim();

            // Reset filter tabs
            document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
            document.querySelector('.filter-tab[data-cat="all"]').classList.add('active');
            document.querySelectorAll('.category-section').forEach(s => s.classList.remove('hidden-section'));

            let anyVisible = false;
            document.querySelectorAll('.faq-item').forEach(item => {
                const matches = !q
                    || item.dataset.question.includes(q)
                    || item.dataset.answer.includes(q);
                item.style.display = matches ? '' : 'none';
                if (matches) anyVisible = true;
            });

            // Hide empty category sections
            document.querySelectorAll('.category-section').forEach(section => {
                const hasVisible = [...section.querySelectorAll('.faq-item')].some(i => i.style.display !== 'none');
                section.classList.toggle('hidden-section', !hasVisible);
            });

            document.getElementById('no-results').style.display = (!q || anyVisible) ? 'none' : 'block';
        });

        // Contact submit
        function submitFaqContact() {
            const email = document.getElementById('faq-contact-email').value.trim();
               if (!email || !email.includes('@@')) {
                alert(tr('Please enter a valid email address.'));
                return;
            }
            // TODO: wire to backend
            alert(tr('Thank you! Our team will reach out within 24 hours.'));
            document.getElementById('faq-contact-email').value = '';
        }
    </script>
}
