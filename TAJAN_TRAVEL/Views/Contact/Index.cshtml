@model ContactViewModel
@using TAJAN_TRAVEL.Models.ViewModels
@{
    ViewData["Title"] = T["Contact"];
    ViewData["Description"] = T["Get in touch with Tajan Travel. Send us an inquiry, visit our Cairo office, or partner with us."];

    // Change these two lines to the real WhatsApp number / office details
    const string whatsappUrl = "https://wa.me/201234567890";
    const string officePhone = "+20 123 456 7890";
    var officePhoneHref = "tel:" + officePhone.Replace(" ", "");
}

<!-- ============ Hero (id is used by the navbar to stay transparent over the image) ============ -->
<section id="hero-section" class="relative min-h-[360px] h-[48vh] max-h-[460px] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center" style="background-image:url('/Golden Nile Sunset from a Palm Terrace.png');"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-tajan-red/40 to-black/40"></div>

    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 pt-16 text-center text-white">
        <div class="flex items-center justify-center gap-4 text-[11px] sm:text-xs uppercase tracking-[0.3em] text-tajan-sand mb-4">
            <span class="w-8 h-px bg-tajan-gold/70"></span>
            <span>@T["Get In Touch"]</span>
            <span class="w-8 h-px bg-tajan-gold/70"></span>
        </div>
        <h1 class="font-display text-3xl sm:text-5xl leading-[1.15]">@T["Let's Craft Your Perfect Journey"]</h1>
    </div>
</section>

<!-- ============ Inquiry form + Our Offices ============ -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 py-14 sm:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">

        <!-- Inquiry form -->
        <div class="lg:pr-6">
            <h2 class="font-display text-3xl sm:text-4xl text-tajan-red mb-3">@T["Send us an Inquiry"]</h2>
            <p class="text-sm text-tajan-red/70 mb-8">@T["Fill out the form below and our advisors will get back to you within 24 hours"]</p>

            @if (TempData["ContactSuccess"] != null)
            {
                <div class="bg-green-50 border border-green-300 text-green-800 text-sm px-4 py-3 mb-8 rounded-md">
                    @T["Thank you — your message has been sent. We'll get back to you shortly."]
                </div>
            }

            <form asp-controller="Contact" asp-action="Index" method="post" class="space-y-7" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-7">
                    <div>
                        <input asp-for="FirstName" placeholder="@T["First Name"]" autocomplete="given-name"
                               class="contact-line" />
                        <span asp-validation-for="FirstName" class="text-xs text-red-600"></span>
                    </div>
                    <div>
                        <input asp-for="LastName" placeholder="@T["Last Name"]" autocomplete="family-name"
                               class="contact-line" />
                        <span asp-validation-for="LastName" class="text-xs text-red-600"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-7">
                    <div>
                        <input asp-for="Email" type="email" placeholder="@T["Email Address"]" autocomplete="email"
                               class="contact-line" />
                        <span asp-validation-for="Email" class="text-xs text-red-600"></span>
                    </div>
                    <div>
                        <input asp-for="PhoneNumber" type="tel" placeholder="@T["Phone Number"]" autocomplete="tel"
                               class="contact-line" />
                        <span asp-validation-for="PhoneNumber" class="text-xs text-red-600"></span>
                    </div>
                </div>

                <div>
                    <textarea asp-for="Message" rows="4" placeholder="@T["Leave us a message..."]"
                              class="contact-line resize-none"></textarea>
                    <span asp-validation-for="Message" class="text-xs text-red-600"></span>
                </div>

                <button type="submit"
                        class="bg-tajan-red text-white px-7 py-3.5 text-xs font-medium uppercase tracking-widest hover:bg-tajan-red/90 transition">
                    @T["Send Inquiry"] &rarr;
                </button>
            </form>
        </div>

        <!-- Our Offices card -->
        <aside class="bg-white border border-tajan-gold/20 shadow-sm rounded-xl p-6 sm:p-8">
            <h3 class="font-display text-2xl text-tajan-red mb-6">@T["Our Offices"]</h3>

            <ul class="space-y-5 text-sm text-tajan-red/80">
                <li class="flex items-start gap-4">
                    <i data-lucide="map-pin" class="w-5 h-5 text-tajan-gold shrink-0 mt-0.5"></i>
                    <span>@T["Cairo, Egypt (Headquarters)"]</span>
                </li>
                <li class="flex items-start gap-4">
                    <i data-lucide="phone" class="w-5 h-5 text-tajan-gold shrink-0 mt-0.5"></i>
                    <a href="tel:+201044338344" class="hover:text-tajan-gold transition">+20 1044338344</a>
                </li>
                <li class="flex items-start gap-4">
                    <i data-lucide="mail" class="w-5 h-5 text-tajan-gold shrink-0 mt-0.5"></i>
                    <a href="mailto:info@tajantravel.com" class="hover:text-tajan-gold transition">info@tajantravel.com</a>
                </li>
                <li class="flex items-start gap-4">
                    <i data-lucide="clock" class="w-5 h-5 text-tajan-gold shrink-0 mt-0.5"></i>
                    <span>@T["Mon - Sat, 9:00 AM - 6:00 PM (EET)"]</span>
                </li>
            </ul>

            <img src="/Sunlit Egyptian Temple of Hieroglyphs.png" alt="@T["Ancient temple columns in Egypt"]"
                 class="w-full aspect-[16/10] object-cover rounded-lg mt-7" loading="lazy" />
        </aside>
    </div>
</section>

<!-- ============ Partner with Tajan ============ -->
<section class="bg-tajan-sand/20 border-y border-tajan-gold/15">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-14 sm:py-20 grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-start">
        <div>
            <div class="text-[11px] sm:text-xs uppercase tracking-[0.25em] text-tajan-gold mb-4">@T["Partner With Tajan"]</div>
            <h2 class="font-display text-4xl sm:text-5xl text-tajan-red leading-tight">@T["Let's Work Together"]</h2>
        </div>
        <div>
            <h3 class="font-display text-2xl sm:text-3xl text-tajan-red leading-snug mb-5">
                @T["Are you a tour operator, travel agency, freelancer, DMC, or company looking to create experiences in Egypt?"]
            </h3>
            <p class="text-tajan-red/75 leading-relaxed mb-7">
                @T["We welcome partnership opportunities across B2B, MICE, individual travelers, and private groups. Tell us a little about your business and what you're looking for, and let's explore how we can work together."]
            </p>
            <button type="button" data-partner-open
                    class="bg-tajan-red text-white px-6 py-3.5 text-xs font-medium uppercase tracking-widest hover:bg-tajan-red/90 transition">
                @T["Become a Partner"] &rarr;
            </button>
        </div>
    </div>
</section>

<!-- ============ WhatsApp banner ============ -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 pt-14 sm:pt-20">
    <div class="bg-[#3A161B] rounded-2xl px-6 sm:px-10 py-9 sm:py-10 flex flex-col md:flex-row md:items-center md:justify-between gap-7 shadow-lg">
        <div class="max-w-xl">
            <div class="flex items-center gap-3 text-[11px] uppercase tracking-[0.25em] text-tajan-gold mb-3">
                <span class="w-6 h-px bg-tajan-gold/60"></span>
                <span>@T["Instant Concierge Service"]</span>
                <span class="w-6 h-px bg-tajan-gold/60"></span>
            </div>
            <h2 class="font-display text-2xl sm:text-3xl text-white mb-3">@T["Prefer a Quick Chat? Connect via WhatsApp"]</h2>
            <p class="text-sm text-tajan-sand/80 leading-relaxed">
                @T["Our private travel advisors are available on WhatsApp for instant itinerary planning, real-time inquiries, and personalized booking support."]
            </p>
        </div>
        <a href="@whatsappUrl" target="_blank" rel="noopener"
           class="inline-flex items-center justify-center gap-2 bg-tajan-gold text-tajan-red px-7 py-4 text-xs font-semibold uppercase tracking-widest hover:bg-tajan-gold/90 transition shrink-0">
            <i data-lucide="message-circle" class="w-4 h-4"></i>
            @T["Chat on WhatsApp"] &rarr;
        </a>
    </div>
</section>

<!-- ============ Partner modal ============ -->
<div id="partner-modal" class="hidden fixed inset-0 z-[100] items-center justify-center p-4"
     role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="partner-modal-title">
    <div id="partner-backdrop" class="absolute inset-0 bg-tajan-red/50 backdrop-blur-sm"></div>

    <div class="relative w-full max-w-2xl bg-white rounded-2xl shadow-2xl overflow-hidden">
        <div class="max-h-[92vh] overflow-y-auto p-6 sm:p-10">

            <button type="button" id="partner-close" aria-label="@T["Close"]"
                    class="absolute top-4 right-4 w-9 h-9 rounded-full border border-tajan-sand flex items-center justify-center text-tajan-red hover:bg-tajan-cream transition">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>

            <div class="text-center mb-7">
                <div class="text-[11px] uppercase tracking-[0.25em] text-tajan-gold mb-2">@T["Partner With Tajan"]</div>
                <h2 id="partner-modal-title" class="font-display text-3xl sm:text-4xl text-tajan-red mb-3">@T["Let's Work Together"]</h2>
                <p class="text-sm text-tajan-red/70 max-w-xs mx-auto">@T["Tell us about your business and how you'd like to collaborate."]</p>
            </div>

            <div id="partner-success" class="hidden text-center py-10">
                <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-green-50 text-green-700 flex items-center justify-center">
                    <i data-lucide="check" class="w-7 h-7"></i>
                </div>
                <h3 class="font-display text-2xl text-tajan-red mb-2">@T["Thank you!"]</h3>
                <p class="text-sm text-tajan-red/70">@T["Our team will reach out within 24 hours."]</p>
            </div>

            <form id="partner-form" asp-controller="Contact" asp-action="Partner" method="post" class="space-y-4" novalidate>
                @Html.AntiForgeryToken()

                <div>
                    <label for="p-FullName" class="partner-label">@T["Full Name"] *</label>
                    <input id="p-FullName" name="FullName" type="text" required placeholder="@T["Enter your full name"]" autocomplete="name" class="partner-input" />
                    <span class="partner-err" data-err-for="FullName"></span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label for="p-BusinessEmail" class="partner-label">@T["Business Email"] *</label>
                        <input id="p-BusinessEmail" name="BusinessEmail" type="email" required placeholder="@T["Enter business email"]" autocomplete="email" class="partner-input" />
                        <span class="partner-err" data-err-for="BusinessEmail"></span>
                    </div>
                    <div>
                        <label for="p-Phone" class="partner-label">@T["Phone / WhatsApp"] *</label>
                        <input id="p-Phone" name="Phone" type="tel" required placeholder="@T["Enter phone or WhatsApp"]" autocomplete="tel" class="partner-input" />
                        <span class="partner-err" data-err-for="Phone"></span>
                    </div>
                </div>

                <div>
                    <label for="p-Company" class="partner-label">@T["Company / Business Name"]</label>
                    <input id="p-Company" name="Company" type="text" placeholder="@T["Enter company or business name"]" autocomplete="organization" class="partner-input" />
                </div>

                <div>
                    <label for="p-Country" class="partner-label">@T["Country"] *</label>
                    <select id="p-Country" name="Country" required class="partner-input">
                        <option value="">@T["Select country"]</option>
                        @foreach (var c in CountryDialCodes.All)
                        {
                            <option value="@c.Name">@c.Name</option>
                        }
                    </select>
                    <span class="partner-err" data-err-for="Country"></span>
                </div>

                <div>
                    <label for="p-Message" class="partner-label">@T["Tell Us About Your Partnership"] *</label>
                    <textarea id="p-Message" name="Message" rows="4" required placeholder="@T["Tell us how you'd like to collaborate."]" class="partner-input resize-none"></textarea>
                    <span class="partner-err" data-err-for="Message"></span>
                </div>

                <div id="partner-error" class="hidden text-sm text-red-600"></div>

                <button type="submit" id="partner-submit"
                        class="w-full bg-tajan-red text-white py-3.5 text-xs font-semibold uppercase tracking-widest hover:bg-tajan-red/90 transition disabled:opacity-60">
                    @T["Submit Partnership Request"] &rarr;
                </button>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Underline-style fields (inquiry form) */
        .contact-line {
            width: 100%;
            background: transparent;
            border: 0;
            border-bottom: 1px solid rgba(75, 30, 35, .25);
            border-radius: 0;
            padding: .6rem 0;
            font-size: .875rem;
            color: #4B1E23;
            outline: none;
            transition: border-color .2s;
        }

            .contact-line::placeholder {
                color: rgba(75, 30, 35, .55);
            }

            .contact-line:focus {
                border-bottom-color: #C8A44D;
            }

        /* Boxed fields (partner popup) */
        .partner-label {
            display: block;
            font-size: .75rem;
            font-weight: 500;
            color: #4B1E23;
            margin-bottom: .35rem;
        }

        .partner-input {
            width: 100%;
            background: #fff;
            border: 1px solid #E7D5AE;
            border-radius: .5rem;
            padding: .7rem .85rem;
            font-size: .8125rem;
            color: #4B1E23;
            outline: none;
            transition: border-color .2s, box-shadow .2s;
        }

            .partner-input::placeholder {
                color: rgba(75, 30, 35, .5);
            }

            .partner-input:focus {
                border-color: #C8A44D;
                box-shadow: 0 0 0 3px rgba(200, 164, 77, .15);
            }

            .partner-input.is-invalid {
                border-color: #dc2626;
            }

        .partner-err {
            display: block;
            font-size: .7rem;
            color: #dc2626;
            margin-top: .2rem;
            min-height: 0;
        }

        #partner-modal.is-open {
            display: flex;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var modal = document.getElementById('partner-modal');
            var form = document.getElementById('partner-form');
            var success = document.getElementById('partner-success');
            var errBox = document.getElementById('partner-error');
            var submitBtn = document.getElementById('partner-submit');
            var lastFocus = null;

            function open() {
                lastFocus = document.activeElement;
                modal.classList.remove('hidden');
                modal.classList.add('is-open');
                modal.setAttribute('aria-hidden', 'false');
                document.body.style.overflow = 'hidden';
                setTimeout(function () { document.getElementById('p-FullName').focus(); }, 50);
            }
            function close() {
                modal.classList.add('hidden');
                modal.classList.remove('is-open');
                modal.setAttribute('aria-hidden', 'true');
                document.body.style.overflow = '';
                if (lastFocus) lastFocus.focus();
            }

            document.querySelectorAll('[data-partner-open]').forEach(function (b) { b.addEventListener('click', open); });
            document.getElementById('partner-close').addEventListener('click', close);
            document.getElementById('partner-backdrop').addEventListener('click', close);
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && modal.classList.contains('is-open')) close();
            });

            function clearErrors() {
                errBox.classList.add('hidden');
                form.querySelectorAll('.partner-err').forEach(function (s) { s.textContent = ''; });
                form.querySelectorAll('.partner-input').forEach(function (i) { i.classList.remove('is-invalid'); });
            }
            function showError(name, msg) {
                var span = form.querySelector('[data-err-for="' + name + '"]');
                var input = form.elements[name];
                if (span) span.textContent = msg;
                if (input) input.classList.add('is-invalid');
            }

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                clearErrors();

                // Quick client-side check
                var ok = true;
                ['FullName', 'BusinessEmail', 'Phone', 'Country', 'Message'].forEach(function (n) {
                    var el = form.elements[n];
                    if (!el.value.trim()) { showError(n, tr('This field is required.')); ok = false; }
                });
                var email = form.elements['BusinessEmail'].value.trim();
                if (email && !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email)) {
                    showError('BusinessEmail', tr('Please enter a valid email address.')); ok = false;
                }
                if (!ok) return;

                submitBtn.disabled = true;
                fetch(form.action, { method: 'POST', body: new FormData(form), headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
                    .then(function (res) {
                        if (res.ok && res.data.success) {
                            form.classList.add('hidden');
                            success.classList.remove('hidden');
                            form.reset();
                            setTimeout(function () {
                                close();
                                form.classList.remove('hidden');
                                success.classList.add('hidden');
                            }, 3500);
                        } else if (res.data && res.data.errors) {
                            Object.keys(res.data.errors).forEach(function (k) { showError(k, res.data.errors[k]); });
                        } else {
                            throw new Error();
                        }
                    })
                    .catch(function () {
                        errBox.textContent = tr('Something went wrong. Please try again.');
                        errBox.classList.remove('hidden');
                    })
                    .finally(function () { submitBtn.disabled = false; });
            });
        })();
    </script>
}
