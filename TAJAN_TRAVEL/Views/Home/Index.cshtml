                    shadow-[0_2px_10px_rgba(0,0,0,0.04)] p-4
                    sm:bg-transparent sm:border-0 sm:shadow-none sm:rounded-none sm:p-0">

                    <!-- Number + Icon -->
                    <div class="flex items-center justify-between sm:justify-start sm:gap-4 mb-4 sm:mb-5">
                        <span class="text-sm font-semibold tracking-wide text-tajan-gold
                             sm:text-[11px] sm:text-tajan-red sm:w-5">
                            @item.Number
                        </span>

                        @if (item.Icon == "BADGE")
                        {
                            <span class="relative w-8 h-8 sm:w-16 sm:h-16 rounded-full overflow-hidden shrink-0
                                 border border-tajan-red/10 bg-white flex flex-col">
                                <span class="flex-1 bg-tajan-gold text-white text-[7px] sm:text-[13px] font-bold leading-none
                                     flex items-end justify-center pb-px sm:pb-0.5">50%</span>
