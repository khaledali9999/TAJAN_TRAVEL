@model HomeViewModel
@{
    ViewData["Title"] = T["Home"];
}

<!-- Hero -->
<section id="hero-section" class="relative h-screen min-h-[650px] flex items-end overflow-hidden">

    <!-- Background Image -->
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat"
         style="background-image: url('/ChatGPT Image Sep 9, 2026, 12_04_29 PM.png');">
    </div>

    <!-- Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-black/10"></div>

    <!-- Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-6 pb-16 w-full text-white -translate-y-10">

        <div class="text-xs uppercase tracking-[0.3em] text-tajan-gold mb-4">
            @T["Private Egypt Tours · Tailored to your needs."]
        </div>

        <h1 class="font-display text-5xl sm:text-6xl leading-tight mb-8">
            @T["Discover Egypt"]<br />
            <span class="italic">@T["Your Way"]</span>
        </h1>

        <div class="flex flex-col sm:flex-row sm:flex-wrap gap-4 mb-10">
            <a asp-controller="Inquiry"
               asp-action="Create"
               class="flex items-center justify-center w-full sm:w-auto min-h-[48px] text-center bg-tajan-red px-6 py-3 text-xs uppercase tracking-widest hover:bg-tajan-red/90 transition">
                @T["Design Your Egypt Tour"]
            </a>

            <a asp-controller="Tours"
               asp-action="Index"
               class="flex items-center justify-center w-full sm:w-auto min-h-[48px] text-center bg-[#C8A44D] text-black px-6 py-3 text-xs uppercase tracking-widest hover:bg-[#C5A93F] transition">
                @T["Discover Our Egypt Tours"]
            </a>
        </div>

    </div>
</section>
@* Faint crown motif in the side margins (wrapper is full width, so the crowns sit at the page edges) *@
<div class="has-crown">
    <crown-motif side="Left" size="Lg" top="6%" />
    <crown-motif side="Right" size="Sm" top="4%" />
    @await Html.PartialAsync("_SearchBar")
</div>

<!-- Why travel with tajan -->
<div class="has-crown">
    <crown-motif side="Right" size="Md" top="2%" />
    <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-4 sm:pt-8 lg:pt-10 pb-12 sm:pb-20 lg:pb-24 text-center">

        <!-- Section Label -->
        <div class="flex items-center justify-center gap-3 sm:gap-4
                text-[10px] sm:text-[11px] uppercase tracking-[0.15em] sm:tracking-[0.3em]
                text-tajan-gold mb-4 sm:mb-6">
            <span class="w-6 sm:w-10 h-px bg-tajan-gold/60"></span>
            <span>@T["Travel Different. Experience More"]</span>
            <span class="w-6 sm:w-10 h-px bg-tajan-gold/60"></span>
        </div>

        <!-- Heading -->
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl leading-tight mb-3 sm:mb-5 text-tajan-red">
            @T["Why travel with"] <span class="uppercase">tajan</span>
        </h2>

        <!-- Description -->
        <p class="text-tajan-red/60 text-sm sm:text-base
              max-w-xs sm:max-w-xl mx-auto mb-8 sm:mb-14 lg:mb-16
              leading-relaxed">
            @T["Personalized Egypt tours, local knowledge, and effortless travel, all designed around you."]
        </p>
        @{
            var whyTajan = new (string Number, string Title, string Text, string ShortTitle, string ShortText, string Icon)[]
            {
        ("01", T["Private Tours"],
        "Enjoy private, flexible tours designed just for you and your group.",
        T["Private Tours"], "Enjoy private, flexible tours designed just for you.",
        "<circle cx='24' cy='15' r='4.5'/><circle cx='13' cy='18' r='3.5'/><circle cx='35' cy='18' r='3.5'/>" +
        "<path d='M15 33c.5-4.5 4-7.5 9-7.5 3 0 5.5 1 7 3'/><path d='M5 32c.3-3.5 2.8-6 6.5-6'/><path d='M43 32c-.3-3.5-2.8-6-6.5-6'/>" +
        "<g stroke='#C8A44D'><rect x='29' y='31' width='11' height='9' rx='2' fill='#FBF8F3'/><path d='M31.5 31v-2.5a3 3 0 0 1 6 0V31'/><circle cx='34.5' cy='35.5' r='.8'/></g>"),

        ("02", T["Dedicated Egypt Tour Operator"],
        T["From planning to your return, you'll have one dedicated person with you all the way."],
        T["Local Guides"], T["A dedicated person with you from start to return."],
        "<circle cx='24' cy='22' r='8'/><path d='M14 22a10 10 0 0 1 20 0'/><rect x='11' y='21' width='4' height='8' rx='2'/><rect x='33' y='21' width='4' height='8' rx='2'/>" +
        "<path d='M35 29c0 4-3 6-8 6'/><circle cx='26' cy='35' r='1.2'/><path d='M12 45c1-6 6-8 12-8s11 2 12 8'/>"),

        ("03", T["On-Ground Tour Leader"],
        T["A professional tour leader is with you on the ground to ensure a smooth and worry-free journey."],
        "On-Ground", T["Professional tour leaders ensure a smooth journey."],
        "<circle cx='22' cy='17' r='5'/><path d='M16 13c1-4 9-5 12 0'/><path d='M12 42v-6c0-5 4-8 10-8s10 3 10 8v6z'/><path d='M32 34l4-8'/>" +
        "<g stroke='#C8A44D'><path d='M36 8v18'/><path d='M36 8l8 3-8 3z'/></g>"),

        ("04", T["Secure Payment"],
        T["Your payments are protected with trusted and secure systems."],
        T["Secure"], T["Payments protected with trusted secure systems."],
        "<rect x='7' y='13' width='30' height='21' rx='3'/><path d='M7 21h30'/><path d='M12 27h11'/><path d='M12 31h7'/>" +
        "<g stroke='#C8A44D'><path d='M34 27l6.5 2.2v5c0 4-3 6.3-6.5 7.5-3.5-1.2-6.5-3.5-6.5-7.5v-5z' fill='#FBF8F3'/><path d='M31 34l2.2 2.2 3.8-4.2'/></g>"),

        ("05", T["Flexible Payment"],
        T["Pay 50% online and the rest upon arrival. Travel with peace of mind."],
        T["Flexible Pay"], T["Pay 50% online and the rest upon arrival."],
        "BADGE"),

        ("06", T["Cancellation Policy"],
        T["We offer clear and fair cancellation terms for your peace of mind."],
        T["Fair Cancel"], T["Clear cancellation terms for peace of mind."],
        "<path d='M24 8l12 4.5v10c0 8-5 13-12 16-7-3-12-8-12-16v-10z'/><path d='M18.5 23l4 4 7-8' stroke='#C8A44D'/>"),
